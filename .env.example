# Public media URL; this is not a secret. No R2 credentials are needed to read media.
# Leave empty until New Spaces has its own media bucket and public URL.
NEXT_PUBLIC_MEDIA_BASE_URL=
# Local default. Set the confirmed canonical domain when preparing launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep drafts out of search until the content and domain are approved.
NEXT_PUBLIC_SITE_INDEXABLE=false
# Local editing works without credentials. Enable GitHub mode only after setup.
NEXT_PUBLIC_KEYSTATIC_STORAGE=local
